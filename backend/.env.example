# Copy this file to .env and fill in real values. Never commit .env.

# Eventbrite API (https://www.eventbrite.com/platform/api-keys)
# Create a free Eventbrite account, generate a "Private Token" from
# Account Settings > Developer Links > API Keys, and paste it below.
# If left blank, the app falls back to SkillsFuture data only and shows
# a friendly notice instead of crashing.
EVENTBRITE_PRIVATE_TOKEN=

# Secret used to sign auth JWTs. Generate any long random string,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET_KEY=change-me-to-a-long-random-string

# SQLite database file path (relative to backend/ working directory)
DATABASE_URL=sqlite:///./skillsg.db

# How often (in hours) cached course data refreshes from providers
COURSE_REFRESH_INTERVAL_HOURS=6

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
