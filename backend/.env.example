# Copy this file to .env and fill in real values. Never commit .env.

# Secret used to sign auth JWTs. Generate any long random string,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET_KEY=change-me-to-a-long-random-string

# SQLite database file path (relative to backend/ working directory)
DATABASE_URL=sqlite:///./skillsg.db

# How often (in hours) cached course data refreshes from providers
COURSE_REFRESH_INTERVAL_HOURS=6

# SkillsFuture live crawl of courses.myskillsfuture.gov.sg search results.
# When true (default), the app crawls the live course directory on startup
# and on each scheduled refresh. Set to false to use the built-in sample
# dataset instead (useful offline). The crawler paginates each seed query
# term below; more terms / pages = more courses but a slower refresh.
SKILLSFUTURE_LIVE_CRAWL=true
SKILLSFUTURE_CRAWL_QUERIES=data,python,cloud,cybersecurity,software,marketing,design,finance,leadership,project management,artificial intelligence,communication,healthcare,logistics,human resources,accounting
SKILLSFUTURE_CRAWL_MAX_PAGES=4
SKILLSFUTURE_CRAWL_CONCURRENCY=6

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM API key — required for the role redesign feature.
# Use whichever provider you prefer (OpenAI takes priority if both set).
# OpenAI:    https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/settings/keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
